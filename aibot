# ---------- быстрая обработка фото и стриминг ответа ----------
def prepare_image(raw: bytes) -> str:
    img = Image.open(io.BytesIO(raw)).convert("RGB")
    img.thumbnail((MAX_SIDE, MAX_SIDE), Image.Resampling.BILINEAR)
    buf = io.BytesIO()
    img.save(buf, "JPEG", quality=JPEG_Q, optimize=True)
    return "data:image/jpeg;base64," + base64.b64encode(buf.getvalue()).decode()


def _stream_chunks(model: str, content):
    """Читает поток байтов строго в UTF-8, чтобы не было кракозябр."""
    payload = {
        "model": model,
        "max_tokens": MAX_TOKENS,
        "temperature": 0.2,
        "stream": True,
        " messages": [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": content},
        ],
    }
    # Поправляем ключ messages и добавляем отключение долгих размышлений, если модель поддерживает
    payload.pop(" messages", None)
    payload["messages"] = [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user", "content": content},
    ]

    with http_session.post(
        BASE_URL + "/chat/completions",
        json=payload,
        stream=True,
        timeout=(10, 90),
    ) as r:
        r.encoding = "utf-8"  # Принудительно ставим UTF-8!
        if r.status_code != 200:
            err_text = r.content.decode("utf-8", errors="replace")[:300]
            raise RuntimeError(f"HTTP {r.status_code}: {err_text}")

        # Читаем сырые байты и декодируем явно в utf-8
        for raw_bytes in r.iter_lines(decode_unicode=False):
            if not raw_bytes:
                continue
            line = raw_bytes.decode("utf-8", errors="replace").strip()
            if not line.startswith("data:"):
                continue
            data_str = line[5:].strip()
            if data_str == "[DONE]":
                break
            try:
                chunk = json.loads(data_str)
                delta = chunk["choices"][0].get("delta") or {}
                piece = delta.get("content") or ""
                if piece:
                    yield fix_mojibake(piece)
            except Exception:
                continue


async def stream_answer(model: str, text: str, image_url, wait_msg) -> str:
    if image_url:
        prompt = (
            text
            or "Реши задания на фото по школьному формату (Дано, Найти, Решение, Ответ) кратко и сразу к делу."
        )
        content = [
            {"type": "image_url", "image_url": {"url": image_url}},
            {"type": "text", "text": prompt},
        ]
    else:
        content = text

    loop = asyncio.get_running_loop()
    queue: asyncio.Queue = asyncio.Queue()

    def producer():
        try:
            for piece in _stream_chunks(model, content):
                loop.call_soon_threadsafe(queue.put_nowait, ("data", piece))
            loop.call_soon_threadsafe(queue.put_nowait, ("done", ""))
        except Exception as e:
            loop.call_soon_threadsafe(queue.put_nowait, ("err", e))

    fut = loop.run_in_executor(None, producer)

    raw_buf = ""
    last_edit = 0.0
    last_shown = ""

    while True:
        kind, val = await queue.get()
        if kind == "err":
            await fut
            raise val
        if kind == "done":
            break
        raw_buf += val
        now = time.monotonic()
        if now - last_edit >= 0.7:
            cleaned = clean_response(raw_buf)
            if cleaned and cleaned != last_shown:
                preview = cleaned[:3900] + " ✍️"
                try:
                    await wait_msg.edit_text(preview)
                    last_shown = cleaned
                    last_edit = now
                except Exception:
                    pass

    await fut
    return clean_response(raw_buf)


async def solve_stream(model: str, text: str, image_url, wait_msg) -> str:
    order = [model] if model == FREE_MODEL else [model, FREE_MODEL]
    last_err = None
    for m in order:
        try:
            ans = await stream_answer(m, text, image_url, wait_msg)
            if ans:
                return ans
        except Exception as e:
            log.warning("Модель %s: %s", m, e)
            last_err = e
    raise RuntimeError(str(last_err) if last_err else "модель вернула пустой ответ")


