def touch_user(u):
    uid = str(u.id)
    uname = u.username or ""
    name = u.full_name or ""
    rec = users.get(uid)
    if rec is None:
        users[uid] = {"username": uname, "name": name, "model": None, "seen": int(time.time())}
        save_users()
        return
    rec["seen"] = int(time.time())
    if rec.get("username") != uname or rec.get("name") != name:
        rec["username"] = uname
        rec["name"] = name
        save_users()


