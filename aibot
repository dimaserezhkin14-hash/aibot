# ---------- лечение кодировки и очистка от LaTeX ----------
def fix_mojibake(s: str) -> str:
    """Если строка случайно декодировалась как latin1 вместо utf-8 (ÐÑÐ¸Ð²ÐµÑ), чинит её."""
    if "Ð" in s or "Ñ" in s:
        try:
            return s.encode("latin1").decode("utf-8")
        except Exception:
            pass
    return s


def clean_response(text: str) -> str:
    """Чинит кодировку и убирает LaTeX ($...$, \\frac, \\text) и разметку (**)."""
    text = fix_mojibake(text)

    # Вырезаем блоки размышлений <think>
    text = re.sub(r"<think>.*?</think>", "", text, flags=re.DOTALL)
    if "<think>" in text:
        text = text.split("<think>")[0]

    for _ in range(3):
        text = re.sub(r"\\(?:text|mathrm|textbf|mathbf|mathit)\{([^{}]*)\}", r"\1", text)

    def repl_frac(m):
        a, b = m.group(1).strip(), m.group(2).strip()
        a_str = f"({a})" if any(c in a for c in "+- ") else a
        b_str = f"({b})" if any(c in b for c in "+- ") else b
        return f"{a_str} / {b_str}"

    for _ in range(4):
        text = re.sub(r"\\(?:d|t)?frac\{([^{}]*)\}\{([^{}]*)\}", repl_frac, text)

    text = re.sub(r"\\sqrt\{([^{}]*)\}", r"√(\1)", text)
    text = text.replace(r"\left", "").replace(r"\right", "")

    replacements = {
        r"\mu": "μ",
        r"\alpha": "α",
        r"\beta": "β",
        r"\gamma": "γ",
        r"\Delta": "Δ",
        r"\delta": "δ",
        r"\pi": "π",
        r"\omega": "ω",
        r"\Omega": "Ом",
        r"\rho": "ρ",
        r"\lambda": "λ",
        r"\eta": "η",
        r"\varphi": "φ",
        r"\phi": "φ",
        r"\cdot": "·",
        r"\times": "×",
        r"\div": ":",
        r"\approx": "≈",
        r"\neq": "≠",
        r"\leq": "≤",
        r"\geq": "≥",
        r"\le": "≤",
        r"\ge": "≥",
        r"\pm": "±",
        r"\rightarrow": "→",
        r"\to": "→",
        r"\Rightarrow": "⇒",
        r"\infty": "∞",
        r"\circ": "°",
        r"\parallel": "||",
        r"\perp": "⊥",
        r"\angle": "∠",
        r"\triangle": "△",
    }
    for k, v in replacements.items():
        text = text.replace(k, v)

    text = re.sub(r"_\{([^{}]*)\}", r"\1", text)
    text = re.sub(r"_([a-zA-Zа-яА-Я0-9]+)", r"\1", text)
    text = re.sub(r"\^\{([^{}]*)\}", r"^\1", text)

    text = text.replace("$$", "").replace("$", "")
    text = text.replace(r"\[", "").replace(r"\]", "").replace(r"\(", "").replace(r"\)", "")
    text = text.replace("{", "").replace("}", "")
    text = re.sub(r"\\([a-zA-Z]+)", r"\1", text)

    text = text.replace("**", "").replace("__", "")
    text = re.sub(r"^#{1,6}\s*", "", text, flags=re.MULTILINE)

    lines = [re.sub(r"[ \t]{2,}", " ", line).strip() for line in text.splitlines()]
    cleaned = "\n".join(lines)
    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned)
    return cleaned.strip()


