    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("model", my_model))
    app.add_handler(CommandHandler("adminf", adminf))
    app.add_handler(CallbackQueryHandler(admin_cb))
    app.add_handler(MessageHandler(filters.PHOTO | (filters.TEXT & ~filters.COMMAND), handle))
    log.info("Бот запущен")
    app.run_polling()


