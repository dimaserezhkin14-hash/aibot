def users_page(page: int):
    ids = sorted(users, key=lambda k: users[k].get("seen", 0), reverse=True)
    pages = max(1, (len(ids) + PAGE - 1) // PAGE)
    page = max(0, min(page, pages - 1))
    rows = []
    for uid in ids[page * PAGE : (page + 1) * PAGE]:
        rec = users[uid]
        who = rec.get("name") or uid
        if rec.get("username"):
            who += " @" + rec["username"]
        mark = "🆓" if not rec.get("model") else "⭐"
        rows.append([InlineKeyboardButton(f"{mark} {who}"[:60], callback_data="usr:" + uid)])
    nav = []
    if page > 0:
        nav.append(InlineKeyboardButton("⬅", callback_data=f"pg:{page - 1}"))
    if page < pages - 1:
        nav.append(InlineKeyboardButton("➡", callback_data=f"pg:{page + 1}"))
    if nav:
        rows.append(nav)
    rows.append([InlineKeyboardButton("↩ Меню", callback_data="adm")])
    if ids:
        text = f"Пользователи: {len(ids)} (стр. {page + 1}/{pages})\n🆓 стандартная модель, ⭐ выдана другая"
    else:
        text = "Пока никто не писал боту."
    return text, InlineKeyboardMarkup(rows)


