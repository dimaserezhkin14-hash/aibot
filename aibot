        await q.edit_message_text(text, reply_markup=markup)
    except Exception as e:
        log.info("edit skipped: %s", e)


async def admin_cb(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    await q.answer()
    data = q.data or ""
    caller_id = str(q.from_user.id)

    if data == "adm":
        context.user_data.pop("await_lookup", None)
        text, markup = main_menu(caller_id)
        await show(q, text, markup)
    elif data.startswith("pg:"):
        text, markup = users_page(int(data[3:]))
        await show(q, text, markup)
    elif data.startswith("usr:"):
        text, markup = user_card(data[4:])
        await show(q, text, markup)
    elif data.startswith("gm:"):
        _, uid, idx = data.split(":")
        mid, name = CATALOG[int(idx)]
        rec = users.setdefault(uid, {"username": "", "name": "", "model": None, "seen": 0})
        rec["model"] = None if mid == FREE_MODEL else mid
        save_users()
        if uid != caller_id:
            try:
                await context.bot.send_message(int(uid), f"Тебе включили модель: {name}")
            except Exception:
                pass
        text, markup = user_card(uid)
        await show(q, text, markup)
    elif data.startswith("rs:"):
        uid = data[3:]
        if uid in users:
            users[uid]["model"] = None
            save_users()
        text, markup = user_card(uid)
        await show(q, text, markup)
    elif data == "find":
        context.user_data["await_lookup"] = True
        await show(
            q,
            "Пришли числовой ID или @username одним сообщением.",
            InlineKeyboardMarkup([[InlineKeyboardButton("↩ Отмена", callback_data="adm")]]),
        )
    elif data == "models":
        await show(q, models_text(), InlineKeyboardMarkup([[InlineKeyboardButton("↩ Меню", callback_data="adm")]]))
    elif data == "close":
        try:
            await q.message.delete()
        except Exception:
            pass


async def lookup_user(msg, t: str):
    t = t.strip()
    uid = None
    if t.lstrip("-").isdigit():
        uid = t
    else:
        uname = t.lstrip("@").lower()
        for k, rec in users.items():
            if (rec.get("username") or "").lower() == uname:
                uid = k
                break
    if not uid:
        await msg.reply_text("Не нашёл. Пришли числовой ID или попроси человека сначала нажать /start.")
        return
    if uid not in users:
        users[uid] = {"username": "", "name": "", "model": None, "seen": 0}
        save_users()
    text, markup = user_card(uid)
    await msg.reply_text(text, reply_markup=markup)


# ---------- основной обработчик ----------
async def handle(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.message
    if not msg:
        return
    user = msg.from_user
    touch_user(user)

    if msg.text and context.user_data.pop("await_lookup", False):
        await lookup_user(msg, msg.text)
        return

    text = (msg.caption or msg.text or "").strip()
    if not msg.photo and not text:
        return

    wait = await msg.reply_text("⚡ Думаю...")

    image_url = None
    if msg.photo:
        # Берём средний размер фото (~800px), чтобы скачать из ТГ мгновенно
        photo_obj = msg.photo[-2] if len(msg.photo) > 1 else msg.photo[-1]
        file = await photo_obj.get_file()
        raw = bytes(await file.download_as_bytearray())
        image_url = await asyncio.to_thread(prepare_image, raw)

    try:
        answer = await solve_stream(get_model(user.id), text, image_url, wait)
    except Exception as e:
        log.exception("Ошибка запроса")
        await wait.edit_text(f"Не получилось: {str(e)[:200]}\nПопробуй ещё раз или смени модель в /adminf.")
        return

    parts = split_text(answer)
    try:
        await wait.edit_text(parts[0])
    except Exception:
        pass
    for part in parts[1:]:
        await msg.reply_text(part)


